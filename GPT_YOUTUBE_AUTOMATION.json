    {
      "parameters": {
        "jsCode": "const merged = $input.all()[0].json;\n\nconst scenes = merged.images; // array of 5 images with narration, image_prompt, image_url\nconst audioUrl = merged.data.attributes.source; // your audio mp3 URL\nconst audioDuration = merged.data.attributes.duration; // full audio length in seconds\n\nconst sceneDuration = audioDuration / scenes.length;\n\nconst imageClips = scenes.map((scene, i) => ({\n  asset: { type: \"image\", src: scene.image_url },\n  start: i * sceneDuration,\n  length: sceneDuration,\n  fit: \"cover\"\n}));\n\nconst captionClips = scenes.map((scene, i) => ({\n  asset: {\n    type: \"html\",\n    html: `<p style=\"color:#ffffff;font-size:36px;text-align:center;\">${scene.narration}</p>`,\n    width: 900,\n    height: 200,\n    background: \"transparent\"\n  },\n  start: i * sceneDuration,\n  length: sceneDuration\n}));\n\nconst timeline = {\n  timeline: {\n    tracks: [\n      { clips: captionClips },\n      { clips: imageClips },\n      { clips: [{ asset: { type: \"audio\", src: audioUrl }, start: 0, length: audioDuration }] }\n    ]\n  },\n  output: { format: \"mp4\", resolution: \"sd\" }\n};\n\nreturn [{ json: timeline }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
