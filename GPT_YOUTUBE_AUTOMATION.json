    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst fullScript = items.map(item => item.json.narration).join(' ');\nreturn [{ json: { fullScript } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1568,
        848
      ],
      "id": "80b4d38b-fd3b-4f60-b806-7888c2109d5f",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst wordsPerSecond = 2.5;\n\nlet currentTime = 0;\nconst scenesWithTiming = items.map(item => {\n  const wordCount = item.json.narration.trim().split(/\\s+/).length;\n  const duration = wordCount / wordsPerSecond;\n  \n  const scene = {\n    narration: item.json.narration,\n    image_prompt: item.json.image_prompt,\n    start: parseFloat(currentTime.toFixed(2)),\n    length: parseFloat(duration.toFixed(2))\n  };\n  \n  currentTime += duration;\n  return scene;\n});\n\nreturn scenesWithTiming.map(scene => ({ json: scene }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
