    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output[0].content[0].text;\nconst scenes = JSON.parse(raw);\n\nreturn scenes.map(scene => ({\n  json: scene\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2016,
